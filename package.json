{
  "name": "dcs-qa-automation-demo",
  "version": "1.0.0",
  "private": true,
  "description": "Local mock airline Departure Control System with Playwright end-to-end QA tests",
  "scripts": {
    "start": "node server.js",
    "test": "playwright test",
    "test:headed": "playwright test --headed",
    "report": "playwright show-report",
    "report:client": "node reports/capture-evidence.js && node reports/generate-client-report.js"
  },
  "devDependencies": {
    "@playwright/test": "^1.55.0"
  }
}
